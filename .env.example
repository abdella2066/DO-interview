# Copy to .env to run the API on the host (make run). docker compose sets its own values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/featureflags
DATABASE_TIMEOUT_SECONDS=5
CACHE_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
API_KEY=local-dev-key
LOG_LEVEL=INFO
